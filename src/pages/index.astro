---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Image } from "astro:assets";
import profileImage from "../assets/profile.jpg";
import careerImage from "../assets/stevergibsoncareer.jpg";
import Testimonials from "../components/Testimonials.astro";
import RecentPosts from "../components/RecentPosts.astro";
import FadeIn from "../components/ui/FadeIn.jsx";
import CampaignIntelligenceFeed from "../components/CampaignIntelligenceFeed.jsx";

const pageTitle = "Steve R Gibson - Marketing Director";
---

<BaseLayout title={pageTitle}>
	<!-- Hero Section -->
	<section
		class="flex flex-col-reverse sm:flex-row items-center justify-between gap-8 py-12 sm:py-20"
	>
		<div class="flex-1 space-y-6 text-center sm:text-left">
			<h1
				class="text-5xl sm:text-7xl font-extrabold tracking-tight text-slate-900 dark:text-white"
			>
				Steve R Gibson
			</h1>
			<h2 class="text-xl sm:text-2xl text-blue-600 font-medium">
				Marketing Director
			</h2>
			<p
				class="text-lg text-slate-600 dark:text-slate-300 leading-relaxed max-w-lg mx-auto sm:mx-0"
			>
				15+ years leading integrated, cross-functional, multi-channel
				growth for national brands. Expert in connecting customer
				insight to positioning and full-funnel execution across Search,
				Social, and Programmatic.
			</p>
			<div class="flex gap-4 justify-center sm:justify-start">
				<a
					href="/CV For Steve Gibson Search and Social Director.pdf"
					class="inline-flex items-center justify-center px-6 py-3 text-base font-medium text-white bg-blue-600 hover:bg-blue-700 rounded-lg shadow-sm transition-colors"
					target="_blank"
				>
					Download Resume
				</a>
				<a
					href="#contact"
					class="inline-flex items-center justify-center px-6 py-3 text-base font-medium text-slate-700 dark:text-slate-200 bg-white dark:bg-slate-800 border border-slate-300 dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-700 rounded-lg shadow-sm transition-colors"
				>
					Contact Me
				</a>
			</div>

			<div
				class="mt-12 grid grid-cols-3 gap-6 border-t border-slate-200 dark:border-slate-800 pt-8"
			>
				<FadeIn client:visible delay={0.1}>
					<div>
						<span
							class="block text-3xl font-bold text-slate-900 dark:text-white"
							>15+</span
						>
						<span class="text-sm text-slate-500 dark:text-slate-400"
							>Years Exp</span
						>
					</div>
				</FadeIn>
				<FadeIn client:visible delay={0.2}>
					<div>
						<span
							class="block text-3xl font-bold text-slate-900 dark:text-white"
							>$90M+</span
						>
						<span class="text-sm text-slate-500 dark:text-slate-400"
							>Ad Spend</span
						>
					</div>
				</FadeIn>
				<FadeIn client:visible delay={0.3}>
					<div>
						<span
							class="block text-3xl font-bold text-slate-900 dark:text-white"
							>30%</span
						>
						<span class="text-sm text-slate-500 dark:text-slate-400"
							>Avg Growth</span
						>
					</div>
				</FadeIn>
			</div>
		</div>

		<div class="flex-shrink-0 w-48 h-48 sm:w-80 sm:h-80 relative">
			<Image
				src={profileImage}
				alt="Steve R Gibson"
				class="rounded-full object-cover w-full h-full shadow-xl border-4 border-white dark:border-slate-800"
				width={320}
				height={320}
			/>
		</div>
	</section>

	<!-- AI Intelligence Feed -->
	<section class="mb-12">
		<CampaignIntelligenceFeed client:load />
	</section>

	<!-- Current Focus (Now Preview) -->
	{
		(async () => {
			const { getEntry } = await import("astro:content");
			const nowData = await getEntry("now", "current");
			if (nowData) {
				const { updatedAt, focus_items } = nowData.data;
				return (
					<section class="mb-20">
						<div class="bg-gradient-to-br from-slate-50 to-white dark:from-slate-900 dark:to-slate-950 rounded-2xl p-8 border border-slate-200 dark:border-slate-800 shadow-sm relative overflow-hidden">
							<div class="absolute top-0 right-0 p-4 opacity-5 text-9xl leading-none select-none pointer-events-none">
								🎯
							</div>
							<div class="relative z-10">
								<div class="flex items-center justify-between mb-6">
									<div class="flex items-center gap-3">
										<span class="relative flex h-3 w-3">
											<span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-blue-400 opacity-75" />
											<span class="relative inline-flex rounded-full h-3 w-3 bg-blue-500" />
										</span>
										<h2 class="text-xs font-bold tracking-widest text-blue-600 uppercase">
											Current Focus
										</h2>
									</div>
									<a
										href="/now"
										class="text-sm font-medium text-slate-500 hover:text-blue-600 transition-colors"
									>
										View All &rarr;
									</a>
								</div>

								<div class="grid grid-cols-1 md:grid-cols-3 gap-6">
									{focus_items
										.slice(0, 3)
										.map((item: any) => (
											<div class="group">
												<div class="text-2xl mb-3 group-hover:scale-110 transition-transform duration-300 origin-left">
													{item.emoji}
												</div>
												<h3 class="font-bold text-slate-900 dark:text-white mb-2 line-clamp-1">
													{item.title}
												</h3>
												<p
													class="text-sm text-slate-600 dark:text-slate-400 line-clamp-3 leading-relaxed"
													set:html={item.description}
												/>
											</div>
										))}
								</div>

								<div class="mt-6 pt-6 border-t border-slate-100 dark:border-slate-800 flex justify-between items-center text-xs text-slate-400">
									<span>Last updated: {updatedAt}</span>
									<span>/now</span>
								</div>
							</div>
						</div>
					</section>
				);
			}
			return null;
		})()
	}

	<!-- Skills Section (Bento Grid) -->
	<section
		id="about"
		class="py-16 md:py-24 border-t border-slate-200/50 dark:border-slate-800/50"
	>
		<div class="mb-10 sm:mb-14">
			<h3
				class="text-3xl md:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight"
			>
				Core Competencies
			</h3>
			<p
				class="mt-3 text-lg text-slate-600 dark:text-slate-400 max-w-2xl"
			>
				The architecture of full-funnel growth, moving from strategy to
				technical execution.
			</p>
		</div>

		<div class="grid grid-cols-1 md:grid-cols-3 gap-6">
			<!-- Strategic Leadership Bento -->
			<div
				class="md:col-span-2 group overflow-hidden bg-slate-50 dark:bg-slate-900/40 p-8 sm:p-10 rounded-3xl border border-slate-200/60 dark:border-slate-800/60 hover:border-blue-500/30 transition-all duration-500 relative"
			>
				<div
					class="absolute top-0 right-0 w-64 h-64 bg-blue-600/5 rounded-full blur-3xl -mr-20 -mt-20 group-hover:bg-blue-600/10 transition-colors"
				>
				</div>
				<h4
					class="font-bold text-2xl mb-6 text-slate-900 dark:text-white flex items-center gap-3 relative z-10"
				>
					<div
						class="p-2.5 bg-blue-100 dark:bg-blue-900/50 text-blue-600 dark:text-blue-400 rounded-xl"
					>
						<svg
							xmlns="http://www.w3.org/2000/svg"
							width="20"
							height="20"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2.5"
							stroke-linecap="round"
							stroke-linejoin="round"
							><path
								d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"
							></path><polyline points="14 2 14 8 20 8"
							></polyline><line x1="16" y1="13" x2="8" y2="13"
							></line><line x1="16" y1="17" x2="8" y2="17"
							></line><polyline points="10 9 9 9 8 9"
							></polyline></svg
						>
					</div>
					Strategic Leadership
				</h4>
				<ul
					class="grid grid-cols-1 sm:grid-cols-2 gap-y-4 gap-x-8 text-slate-700 dark:text-slate-300 font-medium relative z-10"
				>
					<li class="flex items-start gap-3">
						<span
							class="mt-1.5 w-1.5 h-1.5 shrink-0 bg-blue-500 rounded-full"
						></span>
						<span>Integrated Marketing Strategy</span>
					</li>
					<li class="flex items-start gap-3">
						<span
							class="mt-1.5 w-1.5 h-1.5 shrink-0 bg-blue-500 rounded-full"
						></span>
						<span>GTM and Campaign Planning</span>
					</li>
					<li class="flex items-start gap-3">
						<span
							class="mt-1.5 w-1.5 h-1.5 shrink-0 bg-blue-500 rounded-full"
						></span>
						<span>Budget Ownership ($90MM+)</span>
					</li>
					<li class="flex items-start gap-3">
						<span
							class="mt-1.5 w-1.5 h-1.5 shrink-0 bg-blue-500 rounded-full"
						></span>
						<span>Full Funnel Growth</span>
					</li>
					<li class="flex items-start gap-3">
						<span
							class="mt-1.5 w-1.5 h-1.5 shrink-0 bg-blue-500 rounded-full"
						></span>
						<span>Revenue Operations (RevOps)</span>
					</li>
					<li class="flex items-start gap-3">
						<span
							class="mt-1.5 w-1.5 h-1.5 shrink-0 bg-blue-500 rounded-full"
						></span>
						<span>Team Leadership (15+ people)</span>
					</li>
				</ul>
			</div>

			<!-- AI Engine Bento -->
			<div
				class="md:col-span-1 group overflow-hidden bg-gradient-to-br from-blue-600 to-indigo-700 p-8 sm:p-10 rounded-3xl shadow-lg hover:shadow-blue-500/25 transition-all duration-500 text-white relative flex flex-col justify-between"
			>
				<div
					class="absolute inset-0 bg-[url('data:image/svg+xml;base64,')] opacity-30 group-hover:opacity-40 transition-opacity"
				>
				</div>
				<div class="relative z-10">
					<div
						class="inline-flex p-2.5 bg-white/10 rounded-xl backdrop-blur-sm mb-6"
					>
						<svg
							xmlns="http://www.w3.org/2000/svg"
							width="24"
							height="24"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"
							stroke-linejoin="round"
							><path d="M12 2v20"></path><path
								d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"
							></path></svg
						>
					</div>
					<h4 class="font-bold text-2xl mb-3">AI & Growth Systems</h4>
					<p class="text-blue-100 font-medium leading-relaxed">
						Architecting LLM workflows, predictive audience engines,
						and Answer Engine Optimization (AEO).
					</p>
				</div>
				<a
					href="/ai"
					class="mt-8 relative z-10 inline-flex items-center gap-2 text-sm font-bold bg-white text-blue-700 px-4 py-2 rounded-full w-fit hover:bg-blue-50 transition-colors"
				>
					View AI Frameworks <span aria-hidden="true">&rarr;</span>
				</a>
			</div>

			<!-- Technical Stack Bento -->
			<div
				class="md:col-span-3 group overflow-hidden bg-white dark:bg-slate-900/20 p-8 sm:p-10 rounded-3xl border border-slate-200/60 dark:border-slate-800/60 hover:border-emerald-500/30 transition-all duration-500"
			>
				<h4
					class="font-bold text-2xl mb-8 text-slate-900 dark:text-white flex items-center gap-3"
				>
					<div
						class="p-2.5 bg-emerald-100 dark:bg-emerald-900/50 text-emerald-600 dark:text-emerald-400 rounded-xl"
					>
						<svg
							xmlns="http://www.w3.org/2000/svg"
							width="20"
							height="20"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2.5"
							stroke-linecap="round"
							stroke-linejoin="round"
							><rect
								x="2"
								y="3"
								width="20"
								height="14"
								rx="2"
								ry="2"></rect><line
								x1="8"
								y1="21"
								x2="16"
								y2="21"></line><line
								x1="12"
								y1="17"
								x2="12"
								y2="21"></line></svg
						>
					</div>
					Technical & Analytics Stack
				</h4>
				<div class="flex flex-wrap gap-3">
					{
						[
							"Google Ads",
							"GA4",
							"Meta Ads",
							"DV360",
							"Amazon DSP",
							"Microsoft",
							"Performance Max (PMax)",
							"Artificial Intelligence (AI)",
							"LLM Optimization",
							"Looker Studio",
							"SQL & BigQuery",
							"CRM",
						].map((tech) => (
							<span class="px-4 py-2 bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 rounded-xl font-medium text-sm hover:!bg-slate-200 dark:hover:!bg-slate-700 transition-colors cursor-default border border-transparent dark:border-slate-700/50 shadow-sm">
								{tech}
							</span>
						))
					}
				</div>
			</div>
		</div>
	</section>

	<!-- Experience Section (Bento Grid) -->
	<section
		id="experience"
		class="py-16 md:py-24 border-t border-slate-200/50 dark:border-slate-800/50"
	>
		<div
			class="flex flex-col sm:flex-row justify-between items-start sm:items-end gap-6 mb-10 sm:mb-14"
		>
			<div>
				<h3
					class="text-3xl md:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight"
				>
					Professional Experience
				</h3>
				<p
					class="mt-3 text-lg text-slate-600 dark:text-slate-400 max-w-2xl"
				>
					A history of scaling full-funnel performance operations.
				</p>
			</div>
			<a
				href="/media-kit"
				class="inline-flex items-center gap-2 text-sm font-bold text-white bg-slate-900 dark:bg-white dark:text-slate-900 px-5 py-2.5 rounded-full hover:bg-slate-800 dark:hover:bg-slate-100 transition-colors shadow-md"
				>View Full Resume &rarr;</a
			>
		</div>

		<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
			<!-- Experience 1 -->
			<div
				class="group bg-slate-50 dark:bg-slate-900/40 p-8 sm:p-10 rounded-3xl border border-slate-200/60 dark:border-slate-800/60 hover:shadow-xl hover:border-blue-500/30 transition-all duration-300 relative overflow-hidden flex flex-col justify-between"
			>
				<div
					class="absolute top-0 right-0 w-48 h-48 bg-blue-600/5 rounded-full blur-3xl -mr-16 -mt-16 group-hover:bg-blue-600/10 transition-colors"
				>
				</div>
				<div class="relative z-10">
					<div class="flex justify-between items-start mb-6">
						<div>
							<h4
								class="text-2xl font-bold text-slate-900 dark:text-white mb-1"
							>
								Director of Marketing
							</h4>
							<p
								class="text-lg font-medium text-blue-600 dark:text-blue-400"
							>
								Fullman Firm | Irvine, CA
							</p>
						</div>
						<span
							class="text-xs font-bold text-slate-500 uppercase tracking-widest bg-white dark:bg-slate-800 px-3 py-1.5 rounded-full shadow-sm border border-slate-100 dark:border-slate-700"
							>04/2020 - Current</span
						>
					</div>
					<p
						class="text-slate-700 dark:text-slate-300 font-medium mb-6"
					>
						Owned performance marketing, paid search, and
						full-funnel growth for a national debt-relief law firm.
					</p>
					<ul class="space-y-3 mb-8">
						<li
							class="flex items-start gap-3 text-slate-600 dark:text-slate-400 leading-relaxed text-sm"
						>
							<span
								class="mt-1.5 w-1.5 h-1.5 shrink-0 bg-blue-400 rounded-full"
							></span>
							<span
								>Built an AI-assisted audience engine, automated
								qualification workflows, and cross-channel
								measurement processes that improved lead
								velocity.</span
							>
						</li>
						<li
							class="flex items-start gap-3 text-slate-600 dark:text-slate-400 leading-relaxed text-sm"
						>
							<span
								class="mt-1.5 w-1.5 h-1.5 shrink-0 bg-blue-400 rounded-full"
							></span>
							<span
								>Designed and scaled a paid search + PMax
								framework across Google and Microsoft,
								optimizing for qualified consultations via
								offline conversions.</span
							>
						</li>
						<li
							class="flex items-start gap-3 text-slate-600 dark:text-slate-400 leading-relaxed text-sm"
						>
							<span
								class="mt-1.5 w-1.5 h-1.5 shrink-0 bg-emerald-500 rounded-full"
							></span>
							<strong class="text-slate-800 dark:text-slate-200"
								>Reduced CAC by 17%</strong
							> and increased qualified consultation volume without
							increasing media budget.
						</li>
					</ul>
				</div>
			</div>

			<!-- Experience 2 -->
			<div
				class="group bg-slate-50 dark:bg-slate-900/40 p-8 sm:p-10 rounded-3xl border border-slate-200/60 dark:border-slate-800/60 hover:shadow-xl hover:border-slate-400/30 transition-all duration-300 relative overflow-hidden flex flex-col justify-between"
			>
				<div class="relative z-10">
					<div class="flex justify-between items-start mb-6">
						<div>
							<h4
								class="text-2xl font-bold text-slate-900 dark:text-white mb-1"
							>
								VP, Group Director
							</h4>
							<p
								class="text-lg font-medium text-slate-600 dark:text-slate-400"
							>
								Canvas Worldwide | Playa Vista, CA
							</p>
						</div>
						<span
							class="text-xs font-bold text-slate-500 uppercase tracking-widest bg-white dark:bg-slate-800 px-3 py-1.5 rounded-full shadow-sm border border-slate-100 dark:border-slate-700"
							>02/2015 - 04/2020</span
						>
					</div>
					<ul class="space-y-3 mb-8">
						<li
							class="flex items-start gap-3 text-slate-600 dark:text-slate-400 leading-relaxed text-sm"
						>
							<span
								class="mt-1.5 w-1.5 h-1.5 shrink-0 bg-slate-400 rounded-full"
							></span>
							<span
								>Led a 15-person cross-channel team across
								Search, Programmatic, and Social for Hyundai,
								Kia, Genesis, and others.</span
							>
						</li>
						<li
							class="flex items-start gap-3 text-slate-600 dark:text-slate-400 leading-relaxed text-sm"
						>
							<span
								class="mt-1.5 w-1.5 h-1.5 shrink-0 bg-blue-500 rounded-full"
							></span>
							<strong class="text-slate-800 dark:text-slate-200"
								>Managed $90MM+ in annual media;</strong
							> instituted portfolio bidding frameworks. Increased Conversion
							Rate by 6%.
						</li>
						<li
							class="flex items-start gap-3 text-slate-600 dark:text-slate-400 leading-relaxed text-sm"
						>
							<span
								class="mt-1.5 w-1.5 h-1.5 shrink-0 bg-slate-400 rounded-full"
							></span>
							<span
								>Partnered on new-business pitches contributing
								to wins including Wheels Up.</span
							>
						</li>
					</ul>
				</div>
			</div>

			<!-- Experience 3 -->
			<div
				class="group bg-slate-50 dark:bg-slate-900/40 p-8 rounded-3xl border border-slate-200/60 dark:border-slate-800/60 hover:shadow-xl hover:border-slate-400/30 transition-all duration-300"
			>
				<div
					class="flex flex-col sm:flex-row justify-between items-start mb-4 gap-2"
				>
					<div>
						<h4
							class="text-xl font-bold text-slate-900 dark:text-white"
						>
							Client Director
						</h4>
						<p
							class="font-medium text-slate-600 dark:text-slate-400 text-sm mt-1"
						>
							Initiative | Los Angeles, CA
						</p>
					</div>
					<span
						class="text-[10px] font-bold text-slate-500 uppercase tracking-widest bg-white dark:bg-slate-800 px-2.5 py-1 rounded-full border border-slate-100 dark:border-slate-700"
						>01/2013 - 02/2015</span
					>
				</div>
				<ul class="space-y-2">
					<li
						class="flex items-start gap-3 text-slate-600 dark:text-slate-400 leading-relaxed text-sm"
					>
						<span
							class="mt-1.5 w-1.5 h-1.5 shrink-0 bg-slate-300 dark:bg-slate-600 rounded-full"
						></span>
						<span
							>Unified paid search with programmatic prospecting
							and retargeting (RLSA) for Hyundai, Kia, Best
							Western.</span
						>
					</li>
					<li
						class="flex items-start gap-3 text-slate-600 dark:text-slate-400 leading-relaxed text-sm"
					>
						<span
							class="mt-1.5 w-1.5 h-1.5 shrink-0 bg-emerald-500 rounded-full"
						></span>
						<span
							>Introduced ROI portfolio approach: increased
							in-market impression share by 15%, reduced CPC by
							~20%, lower CAC by 10%.</span
						>
					</li>
				</ul>
			</div>

			<!-- Experience 4 -->
			<div
				class="group bg-slate-50 dark:bg-slate-900/40 p-8 rounded-3xl border border-slate-200/60 dark:border-slate-800/60 hover:shadow-xl hover:border-slate-400/30 transition-all duration-300"
			>
				<div
					class="flex flex-col sm:flex-row justify-between items-start mb-4 gap-2"
				>
					<div>
						<h4
							class="text-xl font-bold text-slate-900 dark:text-white"
						>
							Client Director, Search & Video
						</h4>
						<p
