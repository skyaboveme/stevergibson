---

---

<!-- Placeholder to prevent layout shift if needed, but since it's fixed, we rely on padding in body -->
<header
  id="floating-header"
  class="fixed top-6 left-1/2 -translate-x-1/2 z-50 w-auto max-w-[95vw] sm:max-w-3xl transition-all duration-300"
>
  <div
    class="bg-white/70 dark:bg-slate-900/70 backdrop-blur-xl border border-white/20 dark:border-slate-700/50 shadow-2xl dark:shadow-blue-900/20 py-3 px-4 sm:px-8 rounded-full flex items-center justify-between gap-4 sm:gap-8"
  >
    <!-- Mobile Menu Button -->
    <button
      id="mobile-menu-btn"
      class="md:hidden p-2 text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-full transition-colors shrink-0"
      aria-label="Toggle menu"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="h-5 w-5"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
    </button>

    <!-- Desktop Nav -->
    <nav class="hidden md:block">
      <ul
        class="flex space-x-6 text-sm font-semibold items-center text-slate-700 dark:text-slate-300"
      >
        <li>
          <a
            href="/"
            class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors"
            >Home</a
          >
        </li>
        <li>
          <a
            href="/media-kit"
            class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors"
            >Resume</a
          >
        </li>
        <li>
          <a
            href="/blog"
            class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors"
            >Blog</a
          >
        </li>
        <li>
          <a
            href="/case-studies"
            class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors"
            >Cases</a
          >
        </li>
        <li>
          <a
            href="/ai"
            class="hover:text-blue-500 transition-colors font-bold text-blue-600 dark:text-blue-400 flex items-center gap-1"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><path d="M12 2v20"></path><path
                d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"
              ></path></svg
            >
            AI Frameworks
          </a>
        </li>
      </ul>
    </nav>

    <!-- CTA Button (Visible on both Mobile and Desktop) -->
    <a
      href="/#contact"
      class="shrink-0 bg-blue-600 hover:bg-blue-700 text-white text-xs sm:text-sm font-bold px-4 sm:px-5 py-2 sm:py-2.5 rounded-full shadow-lg hover:shadow-blue-500/30 transition-all transform hover:scale-105"
    >
      Hire Me
    </a>
  </div>

  <!-- Mobile Menu Dropdown (Glassmorphic) -->
  <nav
    id="mobile-menu"
    class="hidden md:hidden absolute top-full left-0 right-0 mt-4 bg-white/90 dark:bg-slate-900/90 backdrop-blur-xl border border-white/20 dark:border-slate-700/50 rounded-2xl shadow-2xl p-4 origin-top transition-transform"
  >
    <ul
      class="flex flex-col space-y-3 text-sm font-semibold text-slate-700 dark:text-slate-300"
    >
      <li>
        <a
          href="/"
          class="block px-4 py-2 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-lg transition-colors"
          >Home</a
        >
      </li>
      <li>
        <a
          href="/media-kit"
          class="block px-4 py-2 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-lg transition-colors"
          >Resume / Bio</a
        >
      </li>
      <li>
        <a
          href="/blog"
          class="block px-4 py-2 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-lg transition-colors"
          >Blog</a
        >
      </li>
      <li>
        <a
          href="/case-studies"
          class="block px-4 py-2 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-lg transition-colors"
          >Case Studies</a
        >
      </li>
      <li>
        <a
          href="/know-me"
          class="block px-4 py-2 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-lg transition-colors"
          >Know Me</a
        >
      </li>
      <li>
        <a
          href="/ai"
          class="block px-4 py-2 bg-blue-50 dark:bg-blue-900/20 text-blue-600 dark:text-blue-400 rounded-lg transition-colors mt-2"
          >✦ Applied AI in Marketing</a
        >
      </li>
    </ul>
  </nav>
</header>

<script>
  // Mobile Menu Toggle logic
  const btn = document.getElementById("mobile-menu-btn");
  const menu = document.getElementById("mobile-menu");

  if (btn && menu) {
    btn.addEventListener("click", () => {
      menu.classList.toggle("hidden");
    });

    // Close menu when clicking a link
    menu.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => {
        menu.classList.add("hidden");
      });
    });
  }

  // Optional: Hide header on scroll down, show on scroll up for a cleaner reading experience
  let lastScroll = 0;
  const header = document.getElementById("floating-header");

  window.addEventListener("scroll", () => {
    if (!header) return;
    const currentScroll = window.pageYOffset;

    if (currentScroll <= 0) {
      header.style.transform = "translate(-50%, 0)";
      return;
    }

    if (
      currentScroll > lastScroll &&
      !menu?.classList.contains("hidden") === false
    ) {
      // Scroll down & menu closed -> hide
      header.style.transform = "translate(-50%, -150%)";
    } else {
      // Scroll up -> show
      header.style.transform = "translate(-50%, 0)";
    }

    lastScroll = currentScroll;
  });
</script>
