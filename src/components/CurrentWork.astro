---
import { getEntry } from "astro:content";

interface Props {
    variant?: "home" | "page";
}

const { variant = "home" } = Astro.props;

const work = await getEntry("projects", "work");
if (!work) {
    throw new Error("Could not find 'projects/work' entry");
}

const { groups } = work.data;
const Title = variant === "page" ? "h1" : "h2";
---

<section
    id="current-work"
    class:list={[
        variant === "page"
            ? "mb-8 scroll-mt-28 space-y-14 pt-16 sm:pt-20"
            : "scroll-mt-28 border-t border-slate-200/50 py-16 dark:border-slate-800/50 md:py-24",
    ]}
>
    <div
        class="mb-10 flex flex-col gap-6 sm:mb-14 sm:flex-row sm:items-end sm:justify-between"
    >
        <div class="max-w-2xl">
            <p
                class="mb-3 text-xs font-bold uppercase tracking-widest text-blue-600"
            >
                Personal projects
            </p>
            <Title
                class="text-3xl font-extrabold tracking-tight text-slate-900 dark:text-white md:text-4xl"
            >
                Current Work
            </Title>
            <p class="mt-3 text-lg text-slate-600 dark:text-slate-400">
                What Steve is building on his own: a Bastrop County calendar,
                local news, a civic brief, and a team of marketing agents.
            </p>
        </div>
        {
            variant === "home" && (
                <a
                    href="/projects"
                    class="inline-flex w-fit items-center gap-2 rounded-full bg-slate-900 px-5 py-2.5 text-sm font-bold text-white shadow-md transition-colors hover:bg-slate-800 dark:bg-white dark:text-slate-900 dark:hover:bg-slate-100"
                >
                    Open the full page <span aria-hidden="true">&rarr;</span>
                </a>
            )
        }
    </div>

    <div class="space-y-14">
        {
            groups.map((group) => (
                <div>
                    <div class="mb-6 max-w-2xl">
                        <h3 class="text-xl font-bold text-slate-900 dark:text-white">
                            {group.title}
                        </h3>
                        <p class="mt-2 text-slate-600 dark:text-slate-400">
                            {group.summary}
                        </p>
                    </div>

                    <div
                        class:list={[
                            "grid grid-cols-1 gap-4",
                            group.projects.length > 1 && "sm:grid-cols-2",
                        ]}
                    >
                        {group.projects.map((project) => {
                            const El = project.url ? "a" : "article";
                            return (
                                <El
                                    href={project.url}
                                    target={project.url ? "_blank" : undefined}
                                    rel={
                                        project.url
                                            ? "noopener noreferrer"
                                            : undefined
                                    }
                                    class="group flex flex-col rounded-3xl border border-slate-200/60 bg-slate-50 p-6 transition-all duration-300 hover:border-blue-500/40 hover:shadow-lg focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 dark:border-slate-800/60 dark:bg-slate-900/40"
                                >
                                    <div class="mb-5 flex items-start justify-between gap-4">
                                        <div
                                            class:list={[
                                                "flex shrink-0 items-center justify-center overflow-hidden rounded-2xl border border-slate-200 bg-white dark:border-slate-700",
                                                project.logoWide
                                                    ? "h-16 w-40 px-3"
                                                    : "h-12 w-12",
                                                !project.logo &&
                                                    "border-transparent bg-blue-600 dark:bg-blue-600",
                                            ]}
                                        >
                                            {project.logo ? (
                                                <img
                                                    src={project.logo}
                                                    alt=""
                                                    class:list={[
                                                        "object-contain",
                                                        project.logoWide
                                                            ? "max-h-12 w-full"
                                                            : "h-8 w-8",
                                                    ]}
                                                />
                                            ) : (
                                                <span class="text-sm font-bold tracking-wide text-white">
                                                    {project.mark}
                                                </span>
                                            )}
                                        </div>
                                        {project.url && (
                                            <span class="inline-flex items-center gap-1 text-xs font-semibold text-slate-400 transition-colors group-hover:text-blue-600">
                                                Visit
                                                <span aria-hidden="true">
                                                    &nearr;
                                                </span>
                                            </span>
                                        )}
                                    </div>

                                    <h4 class="text-lg font-bold text-slate-900 dark:text-white">
                                        {project.name}
                                    </h4>
                                    <p class="mt-1 text-sm font-medium text-blue-600 dark:text-blue-400">
                                        {project.role}
                                        {project.location && (
                                            <span class="font-normal text-slate-500 dark:text-slate-400">
                                                {" "}
                                                · {project.location}
                                            </span>
                                        )}
                                    </p>
                                    <p class="mt-3 flex-1 text-sm leading-relaxed text-slate-600 dark:text-slate-300">
                                        {project.description}
                                    </p>
                                    {project.tags.length > 0 && (
                                        <ul class="mt-5 flex flex-wrap gap-2">
                                            {project.tags.map((tag) => (
                                                <li class="rounded-full border border-slate-200 bg-white px-2.5 py-1 text-xs font-medium text-slate-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300">
                                                    {tag}
                                                </li>
                                            ))}
                                        </ul>
                                    )}
                                </El>
                            );
                        })}
                    </div>
                </div>
            ))
        }
    </div>
</section>
